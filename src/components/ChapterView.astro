---
import Icon from "./Icon.astro";
import type { BookMeta, BookPayload, ChapterData } from "../lib/bible";

interface Props {
  books: BookMeta[];
  book: BookPayload;
  chapterObj: ChapterData;
  prevUrl: string | null;
  nextUrl: string | null;
  prevLabel?: string | null;
  nextLabel?: string | null;
}

const {
  books,
  book,
  chapterObj,
  prevUrl,
  nextUrl,
  prevLabel = "Prethodno poglavlje",
  nextLabel = "Sljedeće poglavlje",
} = Astro.props;

// Group books by category
const groups = new Map<string, BookMeta[]>();
for (const b of books) {
  if (!groups.has(b.category)) groups.set(b.category, []);
  groups.get(b.category)!.push(b);
}

const chLabel = chapterObj.chapter === 0 ? "Proslov" : `${chapterObj.chapter}. poglavlje`;
const shortChLabel = chapterObj.chapter === 0 ? "Proslov" : String(chapterObj.chapter);
---

<div
  class="reader-layout"
  id="readerRoot"
  data-book-order={book.order}
  data-book-id={book.id}
  data-book-abbr={book.abbr}
  data-book-title={book.title}
  data-chapter={chapterObj.chapter}
  data-prev-url={prevUrl || ""}
  data-next-url={nextUrl || ""}
>
  <!-- Mobile Drawer Backdrop -->
  <div id="bookDrawerBackdrop" class="drawer-backdrop"></div>

  <!-- Left Book Navigation Sidebar / Mobile Drawer -->
  <aside class="sidebar-card" id="bookSidebarDrawer" aria-label="Popis biblijskih knjiga">
    <div class="sidebar-drawer-header">
      <strong class="sidebar-drawer-title"><Icon name="library" />Knjige Svetoga pisma</strong>
      <button type="button" class="icon-btn" id="btnCloseBookDrawer" title="Zatvori popis knjiga" aria-label="Zatvori"><Icon name="x" /></button>
    </div>

    <div class="filter-row">
      <button class="filter-chip active" data-testament="ALL">Sve (73)</button>
      <button class="filter-chip" data-testament="SZ">SZ (46)</button>
      <button class="filter-chip" data-testament="NZ">NZ (27)</button>
      <button class="filter-chip" data-testament="DEUT" title="Deuterokanonske knjige (7)">DK (7)</button>
    </div>

    <div class="sidebar-search-wrap">
      <input
        type="search"
        id="bookFilterInput"
        class="book-filter-input"
        placeholder="Traži knjigu ili kraticu (npr. Iv, Ps, Sir)..."
      />
    </div>

    <div id="bookListContainer" class="book-list">
      {Array.from(groups.entries()).map(([cat, items]) => (
        <div class="book-group-section" data-category={cat}>
          <div class="book-group-title">{cat}</div>
          {items.map((b) => {
            const firstCh = 1;
            const isAct = b.order === book.order ? "active" : "";
            return (
              <a
                href={`/${b.id}/${firstCh}/`}
                class={`book-item ${isAct}`}
                data-testament-item={b.testament}
                data-deut-item={b.deuterocanonical ? "1" : "0"}
                data-search={`${b.abbr.toLowerCase()} ${b.title.toLowerCase()} ${b.category.toLowerCase()} ${(b.usfm_id || "").toLowerCase()} ${(b.name_en || "").toLowerCase()}`}
              >
                <span class="book-item-left">
                  <span class="book-item-abbr">{b.abbr}</span>
                  <span class="book-item-name">{b.title}</span>
                </span>
                <span class="book-item-count" title={`${b.chapter_count} poglavlja`}>{b.chapter_count}</span>
              </a>
            );
          })}
        </div>
      ))}
    </div>
  </aside>

  <!-- Main Reader Column -->
  <div class="reader-main">
    <!-- Mobile Quick Book Selector Bar -->
    <div class="mobile-reader-bar">
      <button type="button" class="mobile-book-trigger" id="btnOpenBookDrawer">
        <span class="mobile-book-trigger-main"><Icon name="library" /><span class="mobile-book-trigger-text"><strong>{book.abbr} {shortChLabel}</strong><span>{book.title}</span></span></span>
        <span class="mobile-book-trigger-chevron">Promijeni<Icon name="chevron-down" /></span>
      </button>
      <div class="mobile-quick-arrows">
        {prevUrl ? (
          <a href={prevUrl} class="icon-btn icon-only" title={`Prethodno: ${prevLabel}`} aria-label={`Prethodno: ${prevLabel}`}><Icon name="chevron-left" /></a>
        ) : (
          <button class="icon-btn icon-only" disabled aria-label="Nema prethodnog"><Icon name="chevron-left" /></button>
        )}
        {nextUrl ? (
          <a href={nextUrl} class="icon-btn icon-only" title={`Sljedeće: ${nextLabel}`} aria-label={`Sljedeće: ${nextLabel}`}><Icon name="chevron-right" /></a>
        ) : (
          <button class="icon-btn icon-only" disabled aria-label="Nema sljedećeg"><Icon name="chevron-right" /></button>
        )}
      </div>
    </div>

    <!-- Active Biblija 365 Day Banner inside Reader -->
    <div id="readerPlanBanner" class="active-plan-banner" style="display:none;">
      <div class="active-plan-banner-info">
        <div class="active-plan-banner-kicker">Aktivno čitanje iz rasporeda Biblija 365</div>
        <strong id="bannerPlanDayTitle" class="active-plan-banner-title">Biblija 365 — Dan 1</strong>
        <div id="bannerPlanPills" class="plan-reading-pills" style="margin-top:0.4rem;"></div>
      </div>
      <div class="active-plan-banner-actions">
        <button class="icon-btn btn-accent" id="btnBannerMarkDone"><Icon name="check" />Označi dan pročitanim</button>
        <a href="/plan/" class="icon-btn" style="text-decoration:none;" title="Povratak na pregled plana"><Icon name="calendar-days" />Plan</a>
        <button class="icon-btn" id="btnBannerClose" title="Sakrij traku plana" aria-label="Sakrij traku plana"><Icon name="x" /></button>
      </div>
    </div>

    <!-- Chapter Header -->
    <div class="reader-header">
      <div class="reader-kicker-row">
        <div class="reader-badges">
          <span class="badge">{book.testament === "SZ" ? "Stari zavjet" : "Novi zavjet"} · {book.category}</span>
          {book.usfm_id && <span class="badge" title={`Međunarodni USFM kod: ${book.usfm_id} (${book.name_en || ""})`}>USFM: {book.usfm_id}</span>}
          {book.deuterocanonical && <span class="badge badge-accent">Deuterokanonska knjiga</span>}
          {book.deuterocanonical_parts && <span class="badge badge-accent">Deuterokanonski dodaci: {book.deuterocanonical_parts}</span>}
        </div>

        <div class="reader-mode-controls">
          <button
            type="button"
            class="icon-btn"
            id="btnReadingModeToggle"
            title="Prebaci između knjiškog prikaza u odlomcima i studijskog prikaza stih-po-stih"
          >
            <Icon name="pilcrow" />Odjeljci
          </button>
          <button
            type="button"
            class="icon-btn"
            id="btnShareChapter"
            title="Kopiraj poveznicu na ovo poglavlje"
          >
            <Icon name="link" />Podijeli
          </button>
        </div>
      </div>

      <div class="reader-title-row">
        <div>
          <h1 class="reader-book-title">{book.title}</h1>
          <div class="reader-chapter-subtitle">
            <strong>{book.abbr} {shortChLabel}</strong>
            <span class="dot-sep">·</span>
            <span>{chLabel}</span>
            <span class="dot-sep">·</span>
            <span>{chapterObj.verse_count} redaka</span>
          </div>
        </div>

        <div class="desktop-header-arrows">
          {prevUrl ? (
            <a href={prevUrl} class="icon-btn" style="text-decoration:none;" title={`Prethodno: ${prevLabel} (tipka ←)`}>
              <Icon name="chevron-left" />{prevLabel}
            </a>
          ) : null}
          {nextUrl ? (
            <a href={nextUrl} class="icon-btn" style="text-decoration:none;" title={`Sljedeće: ${nextLabel} (tipka →)`}>
              {nextLabel}<Icon name="chevron-right" />
            </a>
          ) : null}
        </div>
      </div>

      <div class="chapter-grid" role="navigation" aria-label={`Poglavlja knjige ${book.title}`}>
        {book.chapters.map((c) => {
          const lbl = c.chapter === 0 ? "Proslov" : String(c.chapter);
          const act = c.chapter === chapterObj.chapter ? "active" : "";
          return (
            <a
              href={`/${book.id}/${c.chapter}/`}
              class={`ch-pill ${act}`}
              title={`${book.title} — ${c.chapter === 0 ? "Proslov" : c.chapter + ". poglavlje"} (${c.verse_count} redaka)`}
            >
              {lbl}
            </a>
          );
        })}
      </div>
    </div>

    <!-- Chapter Reading Body -->
    <article id="chapterBody" class="chapter-body">
      {chapterObj.verses.map((v, idx) => {
        const vLabel = v.verse_label || String(v.verse);
        const isPoetic = Boolean(v.lines && v.lines.length > 1);
        const hasHeading = Boolean(v.headings && v.headings.length > 0);
        const showParaBreak = Boolean(v.p && idx > 0 && !hasHeading && !isPoetic);
        const firstClass = idx === 0 ? "first-verse" : "";
        return (
          <>
            {showParaBreak && <span class="para-break" aria-hidden="true" />}
            {v.headings && v.headings.map((h) => {
              if (h.level === "h2") return <h2 class="sec-h2">{h.text}</h2>;
              if (h.level === "h3") return <h3 class="sec-h3">{h.text}</h3>;
              return <h4 class="sec-h4">{h.text}</h4>;
            })}
            {v.references && v.references.map((refStr) => (
              <div class="sec-ref">{refStr}</div>
            ))}
            {isPoetic ? (
              <span
                class={`verse-item poetic-block ${firstClass}`}
                id={`v-${v.verse}`}
                data-verse={v.verse}
                data-text={v.text}
              >
                {v.lines!.map((ln, lIdx) => (
                  <span class="poetic-line">
                    {lIdx === 0 && <sup class="verse-sup">{vLabel}</sup>}
                    {ln}
                  </span>
                ))}
              </span>
            ) : (
              <span
                class={`verse-item ${firstClass}`}
                id={`v-${v.verse}`}
                data-verse={v.verse}
                data-text={v.text}
              >
                <sup class="verse-sup">{vLabel}</sup>
                <span class="verse-text">{v.text}</span>
              </span>
            )}
            {" "}
          </>
        );
      })}
    </article>

    <!-- Chapter Footer Navigation -->
    <div class="chapter-nav-footer">
      {prevUrl ? (
        <a href={prevUrl} class="chapter-nav-card prev">
          <span class="chapter-nav-kicker"><Icon name="arrow-left" />Prethodno poglavlje</span>
          <strong class="chapter-nav-label">{prevLabel}</strong>
        </a>
      ) : (
        <div />
      )}

      <div class="chapter-nav-center">
        <span class="reader-meta">{book.abbr} {shortChLabel}</span>
        <span class="kbd-hint"><kbd>←</kbd><kbd>→</kbd></span>
      </div>

      {nextUrl ? (
        <a href={nextUrl} class="chapter-nav-card next">
          <span class="chapter-nav-kicker">Sljedeće poglavlje<Icon name="arrow-right" /></span>
          <strong class="chapter-nav-label">{nextLabel}</strong>
        </a>
      ) : (
        <div />
      )}
    </div>
  </div>
</div>
