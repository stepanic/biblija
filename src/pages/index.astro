---
import BaseLayout from "../layouts/BaseLayout.astro";
import ChapterView from "../components/ChapterView.astro";
import { getAllBooks, getBookPayload } from "../lib/bible";

const books = getAllBooks();
const book = getBookPayload(1);
const chapterObj = book.chapters[0];
---

<BaseLayout
  title="Biblija 365 & Offline Pretraživač (Zagrebačka / Jeruzalemska Biblija)"
  activeNav="reader"
>
  <div id="resumeReadingBar" class="resume-reading-banner" style="display:none;">
    <div class="resume-reading-info">
      <span class="badge badge-accent">Nastavi čitanje</span>
      <strong id="resumeReadingLabel" class="resume-reading-label"></strong>
    </div>
    <div class="resume-reading-actions">
      <a id="resumeReadingLink" href="/" class="icon-btn btn-accent" style="text-decoration:none;">
        📖 Nastavi gdje si stao →
      </a>
      <a href="/plan/" class="icon-btn" style="text-decoration:none;">🗓️ Biblija 365</a>
    </div>
  </div>

  <ChapterView
    books={books}
    book={book}
    chapterObj={chapterObj}
    prevUrl={null}
    nextUrl="/knjiga-postanka/2/"
    prevLabel={null}
    nextLabel="Post 2"
  />
</BaseLayout>
