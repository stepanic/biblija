---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getAllBooks } from "../../lib/bible";

const books = getAllBooks();
---

<BaseLayout
  title="Offline Pretraživač Biblije & Brzi skok | Biblija 365"
  description="Trenutna offline pretraga svih 35.394 redaka hrvatske katoličke Biblije i brzi skok po biblijskim kraticama."
  activeNav="search"
>
  <section id="searchPageRoot">
    <div class="card">
      <h1 style="margin:0 0 0.35rem;font-size:1.5rem;">Offline Pretraživač Biblije &amp; Brzi skok po kratici</h1>
      <p style="margin:0 0 0.9rem;color:var(--text-muted);font-size:0.88rem;">
        Upiši <strong>biblijsku referencu</strong> (npr. <code>Iv 1,19</code>, <code>Ps 23</code>, <code>Post 1,1-5</code>, <code>1 Kor 13</code>) za izravan skok, ili <strong>riječ / frazu</strong> (npr. <code>svjetlost</code>, <code>blazenstva</code> bez kvačica ili <code>"duh Božji"</code>) za pretragu svih 35.394 redaka.
      </p>

      <div class="search-bar-wrap">
        <input type="search" id="searchInput" class="search-input" placeholder="Upiši pojam ili referencu (npr. Iv 3,16 ili blaženstva)..." />
        <select id="searchTestamentFilter" class="search-select">
          <option value="">Svi zavjeti (SZ + NZ)</option>
          <option value="SZ">Stari zavjet (SZ)</option>
          <option value="NZ">Novi zavjet (NZ)</option>
        </select>
        <select id="searchBookFilter" class="search-select">
          <option value="">Sve knjige (73)</option>
          {books.map((b) => (
            <option value={b.order}>{b.abbr} — {b.title}</option>
          ))}
        </select>
        <button class="icon-btn" id="btnRunSearch" style="background:var(--accent);color:#fff;border-color:var(--accent);padding:0.6rem 1.1rem;">Pretraži</button>
      </div>

      <div id="directRefCard" style="display:none;margin-bottom:0.8rem;"></div>
      <div id="searchMetaStatus" style="font-size:0.85rem;color:var(--text-muted);margin-bottom:0.5rem;"></div>
      <div id="searchResultsList"></div>
    </div>
  </section>
</BaseLayout>
