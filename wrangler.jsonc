{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "biblija-365",
  // Cloudflare račun D.O.M. (zona domovina.ai)
  "account_id": "7dc7167b7e2e00923bfa7cd697df14e4",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "biblija.domovina.ai", "custom_domain": true }
  ],
  // Migracije: npx wrangler d1 migrations apply biblija-365-db --remote
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "biblija-365-db",
      "database_id": "577be5dc-08e2-470f-a75a-2074dd15570a",
      "migrations_dir": "migrations"
    }
  ],
  "observability": { "enabled": true }
}
